generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RequirementStatus {
  DRAFT
  READY
  NEEDS_CLARIFICATION
  APPROVED
}

enum AnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AIErrorCategory {
  CONFIGURATION
  INPUT_TOO_LARGE
  RATE_LIMIT
  PROVIDER_UNAVAILABLE
  PROVIDER_BAD_RESPONSE
  TIMEOUT
  VALIDATION
  UNKNOWN
}

enum AIJobType {
  REQUIREMENT_ANALYSIS
  TASK_GENERATION
}

enum AIJobStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskType {
  FRONTEND
  BACKEND
  QA
  DEVOPS
  DESIGN
  DOCUMENTATION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum IntegrationProvider {
  GITHUB
  JIRA
  LINEAR
  SLACK
  WEBHOOK
}

enum IntegrationStatus {
  CONNECTED
  PAUSED
  ERROR
}

enum AnalyticsEventType {
  USER_REGISTERED
  PROJECT_CREATED
  REQUIREMENT_CREATED
  REQUIREMENT_ANALYZED
  REQUIREMENT_APPROVED
  TASKS_GENERATED
  SPRINT_CREATED
  ANALYSIS_FEEDBACK_SUBMITTED
}

model User {
  id             String            @id @default(uuid())
  name           String
  email          String            @unique
  passwordHash   String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    WorkspaceMember[]
  sentInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  refreshTokens  RefreshToken[]
  requirements   Requirement[]     @relation("RequirementCreator")
  requirementVersions RequirementVersion[] @relation("RequirementVersionCreator")
  tasksCreated   Task[]            @relation("TaskCreator")
  tasksAssigned  Task[]            @relation("TaskAssignee")
  taskComments   TaskComment[]
  projectActivities ProjectActivity[]
  notifications  Notification[]
  analyticsEvents AnalyticsEvent[]
  aiJobs          AIJob[]
  integrationRuns ProjectIntegrationRun[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  invitedById String
  acceptedAt  DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Project {
  id           String        @id @default(uuid())
  workspaceId  String
  name         String
  key          String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  tasks         Task[]
  sprints       Sprint[]
  aiJobs        AIJob[]
  integrations  ProjectIntegration[]
  integrationRuns ProjectIntegrationRun[]
  taskComments  TaskComment[]
  activities    ProjectActivity[]
  notifications Notification[]
  analyticsEvents AnalyticsEvent[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model AnalyticsEvent {
  id        String             @id @default(uuid())
  type      AnalyticsEventType
  userId    String?
  projectId String?
  entityType String?
  entityId   String?
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now())
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, createdAt])
  @@index([userId, type, createdAt])
  @@index([type, createdAt])
}

model ProjectIntegration {
  id             String              @id @default(uuid())
  projectId      String
  provider       IntegrationProvider
  status         IntegrationStatus   @default(CONNECTED)
  displayName    String
  externalRef    String?
  config         Json                @default("{}")
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs           ProjectIntegrationRun[]

  @@unique([projectId, provider, displayName])
  @@index([projectId, provider, status])
}

model ProjectIntegrationRun {
  id            String             @id @default(uuid())
  integrationId String
  projectId     String
  actorId       String
  action        String
  status        IntegrationStatus
  requestSummary Json              @default("{}")
  responseCode  Int?
  responseBody  String?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  integration   ProjectIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor         User               @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([projectId, createdAt])
}

model Requirement {
  id             String            @id @default(uuid())
  projectId      String
  createdById    String
  title          String
  currentContent String
  status         RequirementStatus @default(DRAFT)
  clarificationAnswers Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("RequirementCreator", fields: [createdById], references: [id])
  versions       RequirementVersion[]
  analyses       AIAnalysis[]
  tasks          Task[]
  jobs           AIJob[]

  @@index([projectId, status])
}

model RequirementVersion {
  id            String       @id @default(uuid())
  requirementId String
  createdById   String
  versionNumber Int
  content       String
  createdAt     DateTime     @default(now())
  requirement   Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("RequirementVersionCreator", fields: [createdById], references: [id])
  analyses      AIAnalysis[]

  @@unique([requirementId, versionNumber])
  @@index([requirementId, createdAt])
}

model AIAnalysis {
  id                        String         @id @default(uuid())
  requirementId             String
  requirementVersionId      String
  provider                  String
  model                     String
  status                    AnalysisStatus @default(PROCESSING)
  clarificationQuestions    Json?
  functionalRequirements    Json?
  nonFunctionalRequirements Json?
  userStories               Json?
  technicalPlan             Json?
  risks                     Json?
  rawOutput                 Json?
  errorMessage              String?
  errorCategory             AIErrorCategory?
  promptSchemaVersion       String         @default("v1")
  attempts                  Int            @default(0)
  durationMs                Int?
  promptTokens              Int?
  completionTokens          Int?
  totalTokens               Int?
  taskGenerationAttempts    Int            @default(0)
  taskGenerationDurationMs  Int?
  taskGenerationPromptTokens Int?
  taskGenerationCompletionTokens Int?
  taskGenerationTotalTokens Int?
  taskGenerationErrorCategory AIErrorCategory?
  taskGenerationErrorMessage String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  requirement               Requirement    @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  requirementVersion        RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Cascade)
  tasks                     Task[]
  jobs                      AIJob[]

  @@index([requirementId, createdAt])
  @@index([requirementVersionId, status])
}

model AIJob {
  id                   String           @id @default(uuid())
  type                 AIJobType
  status               AIJobStatus      @default(QUEUED)
  userId               String
  projectId            String
  requirementId        String?
  analysisId           String?
  idempotencyKey       String
  provider             String?
  model                String?
  promptSchemaVersion  String?
  attempts             Int              @default(0)
  maxAttempts          Int              @default(3)
  durationMs           Int?
  promptTokens         Int?
  completionTokens     Int?
  totalTokens          Int?
  errorCategory        AIErrorCategory?
  errorMessage         String?
  outputRef            String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement          Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  analysis             AIAnalysis?      @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@unique([type, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([requirementId, type, createdAt])
  @@index([analysisId, type, createdAt])
}

model Task {
  id                 String       @id @default(uuid())
  projectId          String
  requirementId      String?
  analysisId         String?
  sprintId           String?
  createdById        String
  assigneeId         String?
  title              String
  description        String
  type               TaskType
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus   @default(BACKLOG)
  storyPoints        Int?
  acceptanceCriteria Json?
  labels             String[]     @default([])
  position           Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement        Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  analysis           AIAnalysis?  @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  sprint             Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy          User         @relation("TaskCreator", fields: [createdById], references: [id])
  assignee           User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments           TaskComment[]

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([analysisId])
  @@index([sprintId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  projectId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
}

model ProjectActivity {
  id         String   @id @default(uuid())
  projectId  String
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  title     String
  body      String?
  readAt    DateTime?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([projectId, createdAt])
}

model Sprint {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  goal           String?
  status         SprintStatus @default(PLANNED)
  startDate      DateTime?
  endDate        DateTime?
  capacityPoints Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@unique([projectId, name])
  @@index([projectId, status])
}
